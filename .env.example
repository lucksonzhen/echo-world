# Only the backend reads this secret. Never use an EXPO_PUBLIC_ prefix for API keys.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Alternatively, set AI_PROVIDER=gemini and configure this key (or inherit it from the environment).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=8787
HOST=0.0.0.0
# For a phone, use your server's HTTPS URL or local computer's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Optional private-deployment access token. Enter it in the app's connection settings.
APP_ACCESS_TOKEN=
# Comma-separated allowed web origins. Native apps do not send Origin.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Optional existing HTTP proxy. npm run server:local uses these with Node.js 24.5+.
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,10.0.2.2
